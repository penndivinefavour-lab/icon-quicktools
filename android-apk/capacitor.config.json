{
  "appId": "com.iconstudios.quicktools",
  "appName": "ICON QuickTools",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1a2744",
    "inputInsetsAdjustment": "resize",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1a2744"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    },
    "App": {
      "appUrlScheme": "https"
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
